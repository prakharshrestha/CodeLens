# DevOps Ignore Patterns

# ---- Environment ----
.env
.env.local
.env.production

# ---- Java / Maven ----
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.jar
*.war

# ---- Node / npm ----
frontend/node_modules/
frontend/dist/
frontend/.vite/

# ---- IDE ----
.idea/
*.iml
.vscode/
*.swp
*.swo

# ---- Logs ----
*.log
logs/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Docker ----
.dockerignore

# ---- Misc ----
*.tmp
*.bak
