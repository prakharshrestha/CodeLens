# DevOps Command Center — Environment Variables Template
# Copy this to .env and fill in your values

# ---- Database ----
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---- JWT ----
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ---- GitHub ----
# Get from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_USERNAME=prakharshrestha

# ---- Jenkins ----
JENKINS_URL=http://localhost:8090
JENKINS_USERNAME=admin
JENKINS_TOKEN=your_jenkins_api_token_here

# ---- Docker ----
# Enable Docker TCP socket: dockerd --host=tcp://0.0.0.0:2375 --host=unix:///var/run/docker.sock
DOCKER_HOST=tcp://localhost:2375

# ---- Deployment ----
EC2_HOST=your_ec2_public_ip_here
API_BASE_URL=http://localhost:8080/api
